# Universal SSO gateway client settings. Copy to .env and adjust. No secrets belong here:
# the OAuth client id/secret, signing keys and tokens stay in the gateway's own .env.

# Base URL of ssod. Plain http is only accepted for loopback hosts; use https elsewhere.
SSO_GATEWAY_URL=http://localhost:8080

# Provider id registered in the gateway. Default for this example: okta
SSO_PROVIDER=okta

# Optional: pin the identity-provider host. The login redirect must go to this host or a
# subdomain (for example your tenant host). Leave empty to skip the check.
SSO_EXPECTED_IDP_HOST=

# Optional: request timeout in seconds, 1 to 300 (default 10).
SSO_HTTP_TIMEOUT_SECONDS=10
