# Server Configuration
SSO_SERVER_HOST=127.0.0.1
SSO_SERVER_PORT=8080
SSO_SERVER_BASE_URL=http://localhost:8080
SSO_LOG_LEVEL=info
SSO_STATE_SECRET=change-this-super-secret-key-32bytes-min!

# Okta Provider Configuration
SSO_PROVIDERS_OKTA_CLIENT_ID=0oa123456789okta
SSO_PROVIDERS_OKTA_CLIENT_SECRET=okta-client-secret-placeholder
SSO_PROVIDERS_OKTA_ISSUER_URL=https://dev-example.okta.com/oauth2/default
SSO_PROVIDERS_OKTA_REDIRECT_URL=http://localhost:8080/auth/okta/callback

# Auth0 Provider Configuration
SSO_PROVIDERS_AUTH0_CLIENT_ID=auth0-client-id-placeholder
SSO_PROVIDERS_AUTH0_CLIENT_SECRET=auth0-client-secret-placeholder
SSO_PROVIDERS_AUTH0_ISSUER_URL=https://example.us.auth0.com/
SSO_PROVIDERS_AUTH0_REDIRECT_URL=http://localhost:8080/auth/auth0/callback

# Azure AD / Microsoft Entra ID
SSO_PROVIDERS_AZURE_CLIENT_ID=azure-client-id-placeholder
SSO_PROVIDERS_AZURE_CLIENT_SECRET=azure-client-secret-placeholder
SSO_PROVIDERS_AZURE_TENANT_ID=common
SSO_PROVIDERS_AZURE_REDIRECT_URL=http://localhost:8080/auth/azure/callback

# Google Workspace Provider Configuration (guide: Docs/Google-SSO-Setup.md; validate with: make google-check)
# Client ID is <project-number>-<random> followed by the Google suffix (see the guide)
SSO_PROVIDERS_GOOGLE_CLIENT_ID=google-client-id-placeholder
# Client secret starts with GOCSPX- and is shown by Google only once
SSO_PROVIDERS_GOOGLE_CLIENT_SECRET=google-client-secret-placeholder
SSO_PROVIDERS_GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
# Optional: restrict sign-in to one Google Workspace domain (enforced from the ID token hd claim)
# SSO_PROVIDERS_GOOGLE_HOSTED_DOMAIN=example.com
